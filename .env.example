# Copy this file to .env and enter your own credentials locally.
# Never commit .env or paste API keys into chat.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-this-password

BINANCE_ENV=demo
TRADING_ENABLED=false
TRADE_AMOUNT_USDT=1000
MAX_SPOT_CONCURRENT_TRADES=6
MAX_FUTURES_CONCURRENT_TRADES=6
MAX_DAILY_LOSS_PCT=5.0
MAX_PORTFOLIO_OPEN_RISK_PCT=8.0
MAX_CORRELATED_CLUSTER_RISK_PCT=4.0
MAX_TICKER_AGE_SECONDS=120
MAX_SPOT_HEDGE_RATIO=0.5

# Futures Demo forced one-time test. Keep disabled unless intentionally arming a test.
FORCE_FUTURES_TEST_TRADE=false
FORCE_FUTURES_TEST_ID=
FORCE_FUTURES_TEST_SIDE=long

BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_FUTURES_API_KEY=
BINANCE_FUTURES_SECRET_KEY=
CREDENTIAL_ENCRYPTION_KEY=

GROQ_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Active entries. Default is the two long-only spot strategies.
# Old strategies stay in the code. Set STRATEGY_MODE=legacy to use them again,
# or list any mix in ACTIVE_STRATEGIES. Database bot_settings does not override these.
STRATEGY_MODE=core
ACTIVE_STRATEGIES=trend_pullback,donchian_breakout
# Futures keeps managing open positions. New futures entries stay off (no leverage).
FUTURES_NEW_ENTRIES_ENABLED=false

# trend_pullback: 4h, long only, stop = 2*ATR, default take-profit 2R.
# TP_EXIT_METHOD=tp_2r or trail. Risk is capped by RISK_PER_TRADE_PCT and must be in (0, 2].
TREND_PULLBACK_RISK_PCT=0.5
TP_EXIT_METHOD=tp_2r
TP_R_MULTIPLE=2
TP_TRAIL_ATR=2
PULLBACK_LOOKBACK=6
PULLBACK_NEAR_ATR=0.25
ATR_SPIKE_MULT=2
ATR_MEDIAN_WINDOW=48

# donchian_breakout: 4h close above the prior 20 highs, BTC daily close > EMA200.
# DONCHIAN_EXIT_METHOD=channel (close under prior 10 lows) or atr_trail (3*ATR).
DONCHIAN_BREAKOUT_RISK_PCT=0.25
DONCHIAN_EXIT_METHOD=channel
DONCHIAN_ENTRY_LOOKBACK=20
DONCHIAN_EXIT_LOOKBACK=10
DONCHIAN_TRAIL_ATR=3

# Shared safety. Effective daily-loss limit is min(MAX_DAILY_LOSS_PCT, DAILY_LOSS_LIMIT_PCT).
# Effective open-risk cap is min(MAX_PORTFOLIO_OPEN_RISK_PCT, PORTFOLIO_MAX_OPEN_RISK_PCT).
# MAX_OPEN_POSITIONS is an extra cap on top of MAX_SPOT_CONCURRENT_TRADES (the lower one wins).
DAILY_LOSS_LIMIT_PCT=2
MAX_OPEN_POSITIONS=4
PORTFOLIO_MAX_OPEN_RISK_PCT=4
KILL_SWITCH_ENABLED=true
KILL_SWITCH_AUTO_CLEAR=true
KILL_SWITCH_MAX_CANDLE_AGE_SECONDS=21600
KILL_SWITCH_MAX_DAILY_AGE_SECONDS=129600
CORE_ENTRY_ORDER_MODE=limit_then_market
CORE_MAX_SPREAD_PCT=0.15
CORE_TAKER_FEE_PCT=0.1
CORE_SLIPPAGE_PCT=0.05
CORE_MAX_COST_FRACTION_OF_R=0.35
# CORE_SYMBOLS=BTC/USDT,ETH/USDT,BNB/USDT,SOL/USDT,XRP/USDT,ADA/USDT,DOGE/USDT,LINK/USDT,AVAX/USDT,DOT/USDT,LTC/USDT,BCH/USDT,TRX/USDT

# Spot guard v2
SPOT_ENFORCE_STOP_CAP_LEGACY=true   # tighten open Spot stops wider than SPOT_TREND_MAX_STOP_PCT
SPOT_STOP_WATCHDOG=true             # market-close + warn when price <= stop (missed/gapped stop)
SPOT_TREND_ENABLED=false            # trend strategies paused on Spot (bounce unchanged)
SPOT_TREND_REQUIRE_1D_CONFIRM=true  # when enabled: price above rising daily EMA20
SPOT_TREND_MIN_VOL_MULT=1.2         # when enabled: last bar volume >= 1.2x 20-bar avg (0 = off)

# Read-only match of unverified closed Spot trades to Binance fills.
# Never places or cancels orders. Safe to leave on: a failed read is retried later.
SPOT_RECONCILE_ENABLED=true
SPOT_RECONCILE_INTERVAL_MIN=60
SPOT_RECONCILE_PAUSE_SEC=0.25
SPOT_RECONCILE_QTY_TOLERANCE=0.005
# No stored order id: match one buy+sell whose fills sit inside this many seconds
# of the recorded close. matched_by_time counts in realized PnL and is listed apart
# from order-id matches. Set the toggle false to keep those rows unverified.
SPOT_RECONCILE_FALLBACK_ENABLED=true
SPOT_RECONCILE_FALLBACK_WINDOW_SEC=180
