# Copy this file to .env and replace placeholders with your own values.
# Keep BINANCE_ENV=demo. Do not use live API credentials here.
BINANCE_ENV=demo
TRADING_ENABLED=false
CONFIRM_LIVE_TRADING=
FORCE_TEST_TRADE=false

BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Generate a unique Fernet key for this installation; never share it.
CREDENTIAL_ENCRYPTION_KEY=generate-a-unique-key-before-use

TRADE_AMOUNT_USDT=100
MAX_CONCURRENT_TRADES=2
TIMEFRAME=1h
EMA_PERIOD=50
RSI_MAX_ENTRY=70
REQUIRE_MACD=true

NEWS_FILTER=true
NEWS_PAUSE_HOURS=3
NEWS_WINDOW_HOURS=6
NEWS_BLOCK_SEVERITY=4
GROQ_API_KEY=
GROQ_MODEL=
FIRECRAWL_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Replace these placeholders before using the dashboard.
DASHBOARD_USER=change-me
DASHBOARD_PASSWORD=change-me-before-use
