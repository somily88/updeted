:root {
  --bg: #050b08;
  --bg-2: #0d1411;
  --panel: rgba(10, 17, 13, 0.9);
  --panel-strong: #0f1c14;
  --panel-muted: #101c17;
  --card: #111d18;
  --card-2: #16251d;
  --line: rgba(130, 169, 146, 0.22);
  --text: #ebfff2;
  --muted: #9bb5a3;
  --green: #2ae782;
  --green-2: #3ddf9f;
  --green-3: #a8ffd4;
  --red: #ff5f6d;
  --amber: #ffc857;
  --shadow: 0 16px 40px rgba(2, 10, 6, 0.7);
  --radius: 20px;
}

* {
  box-sizing: border-box;
}

html {
  background: var(--bg);
  color: var(--text);
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  background:
    radial-gradient(circle at top left, rgba(42, 231, 130, 0.18), transparent 20%),
    radial-gradient(circle at top right, rgba(0, 255, 179, 0.12), transparent 18%),
    var(--bg);
  color: var(--text);
}

button, input {
  font: inherit;
}

button {
  cursor: pointer;
}

.loading-shell {
  min-height: 100vh;
  display: grid;
  place-items: center;
  font-size: 1.2rem;
  color: var(--muted);
}

.dashboard-shell {
  max-width: 1440px;
  margin: 0 auto;
  padding: 24px 18px 40px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 14px;
  padding: 16px 18px;
  border-radius: 20px;
  border: 1px solid var(--line);
  background: rgba(15, 25, 20, 0.9);
  box-shadow: var(--shadow);
  backdrop-filter: blur(10px);
}

.brand-wrap {
  display: flex;
  align-items: center;
  gap: 14px;
}

.brand-logo {
  width: 42px;
  height: 42px;
  border-radius: 14px;
  display: grid;
  place-items: center;
  font-weight: 800;
  background: linear-gradient(135deg, var(--green), #0d9c62 60%, #68ffb0);
  color: #04170d;
}

.brand-title {
  font-weight: 800;
  letter-spacing: 0.02em;
}

.brand-wrap small {
  display: block;
  color: var(--muted);
  font-size: 0.72rem;
}

.status-pills {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8px;
}

.pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 7px 12px;
  border-radius: 999px;
  border: 1px solid var(--line);
  background: rgba(255, 255, 255, 0.02);
  color: var(--muted);
  font-size: 0.72rem;
  font-weight: 700;
}

.pill::before {
  content: '';
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 0 0 10px currentColor;
}

.pill--green { color: var(--green); }
.pill--neutral { color: var(--green-3); }

.primary-btn,
.secondary-btn {
  border: 0;
  border-radius: 12px;
  padding: 10px 16px;
  font-weight: 700;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.primary-btn {
  background: linear-gradient(135deg, var(--green), #1fcc82);
  color: #03150c;
  box-shadow: 0 8px 24px rgba(42, 231, 130, 0.35);
}

.secondary-btn {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--line);
  color: var(--text);
}

.primary-btn:hover,
.secondary-btn:hover {
  transform: translateY(-1px);
}

.main-grid {
  display: grid;
  gap: 18px;
  margin-top: 18px;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 18px;
}

.stat-card {
  background: linear-gradient(180deg, rgba(17, 29, 24, 0.9), rgba(14, 20, 17, 0.9));
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 18px 18px 16px;
  box-shadow: var(--shadow);
}

.stat-card--accent {
  background: linear-gradient(135deg, rgba(42, 231, 130, 0.2), rgba(17, 29, 24, 0.95));
}

.stat-card__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  color: var(--muted);
  font-size: 0.76rem;
}

.stat-card__value {
  margin-top: 14px;
  font-size: clamp(1.5rem, 2vw, 2.2rem);
  font-weight: 800;
  letter-spacing: -0.05em;
}

.stat-card__sub {
  margin-top: 10px;
  color: var(--muted);
  font-size: 0.76rem;
  line-height: 1.5;
}

.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 34px;
  padding: 5px 9px;
  border-radius: 999px;
  font-size: 0.66rem;
  font-weight: 700;
  border: 1px solid var(--line);
}

.badge--positive { background: rgba(42, 231, 130, 0.14); color: var(--green); }
.badge--negative { background: rgba(255, 95, 109, 0.12); color: var(--red); }
.badge--neutral { background: rgba(168,255,212,0.08); color: var(--green-3); }

.content-grid {
  display: grid;
  gap: 18px;
}

.content-grid--two {
  grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.8fr);
}

.content-grid--market {
  grid-template-columns: 1fr;
}

.panel {
  background: linear-gradient(180deg, rgba(16, 23, 19, 0.95), rgba(13, 18, 15, 0.96));
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 20px;
  box-shadow: var(--shadow);
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-bottom: 14px;
}

.panel-header h2 {
  margin: 0;
  font-size: 1.08rem;
}

.small-badge {
  display: inline-flex;
  align-items: center;
  border: 1px solid var(--line);
  border-radius: 999px;
  padding: 5px 10px;
  color: var(--muted);
  font-size: 0.72rem;
}

.chart-svg {
  display: block;
  width: 100%;
  height: 220px;
  border-radius: 16px;
  background: linear-gradient(180deg, rgba(19, 29, 24, 0.7), rgba(9, 13, 10, 0.7));
  border: 1px solid var(--line);
}

.account-list {
  display: grid;
  gap: 12px;
}

.account-card {
  background: rgba(255,255,255,0.02);
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 14px;
}

.account-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-bottom: 12px;
}

.mini-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.mini-grid small {
  display: block;
  color: var(--muted);
  margin-bottom: 4px;
}

.mini-grid b {
  font-size: 0.95rem;
}

.market-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
}

.market-card {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 14px;
}

.market-card__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
  margin-bottom: 8px;
}

.market-symbol {
  font-weight: 800;
}

.market-price {
  font-size: 1.3rem;
  font-weight: 800;
  letter-spacing: -0.04em;
  margin-bottom: 10px;
}

.market-bar {
  width: 100%;
  height: 8px;
  border-radius: 999px;
  background: rgba(255,255,255,0.06);
  overflow: hidden;
}

.market-bar span {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--green-2), var(--green), #9fffc7);
}

.market-meta {
  margin-top: 8px;
  color: var(--muted);
  font-size: 0.72rem;
}

.table-wrap {
  overflow-x: auto;
}

table {
  width: 100%;
  border-collapse: collapse;
}

thead th {
  color: var(--muted);
  font-size: 0.72rem;
  text-align: right;
  padding: 10px 8px;
  border-bottom: 1px solid var(--line);
}

tbody td {
  padding: 12px 8px;
  border-bottom: 1px solid rgba(255,255,255,0.04);
  font-size: 0.84rem;
}

.empty-state {
  color: var(--muted);
  text-align: center;
  padding: 18px 8px;
}

.positive-text { color: var(--green); }
.negative-text { color: var(--red); }

.decision-list {
  display: grid;
  gap: 12px;
}

.decision-item {
  background: rgba(255,255,255,0.02);
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 12px 14px;
}

.decision-item__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
  margin-bottom: 8px;
}

.decision-item__meta,
.decision-item__reason {
  color: var(--muted);
  font-size: 0.75rem;
  line-height: 1.7;
}

.news-box {
  display: grid;
  gap: 14px;
}

.news-summary {
  color: var(--muted);
  line-height: 1.7;
  font-size: 0.8rem;
}

.news-list {
  display: grid;
  gap: 10px;
}

.news-item {
  display: grid;
  gap: 4px;
  padding: 10px 12px;
  border-radius: 12px;
  background: rgba(255,255,255,0.02);
  border: 1px solid var(--line);
  color: var(--muted);
  font-size: 0.75rem;
}

.news-item strong {
  color: var(--text);
}

.settings-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.settings-form,
.credential-form {
  display: grid;
  gap: 16px;
}

.field-grid {
  display: grid;
  gap: 12px;
}

label {
  display: grid;
  gap: 7px;
  color: var(--muted);
  font-size: 0.8rem;
}

input {
  width: 100%;
  padding: 11px 12px;
  border-radius: 12px;
  border: 1px solid var(--line);
  background: rgba(255,255,255,0.02);
  color: var(--text);
  outline: none;
}

input:focus {
  border-color: rgba(42,231,130,0.7);
  box-shadow: 0 0 0 3px rgba(42,231,130,0.12);
}

.form-message {
  min-height: 18px;
  color: var(--green-3);
  font-size: 0.75rem;
}

.credentials-box {
  display: grid;
  gap: 18px;
}

.credential-form {
  background: rgba(255,255,255,0.02);
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 14px;
}

.credential-form h3 {
  margin: 0;
  font-size: 1rem;
}

@media (max-width: 1200px) {
  .stats-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (max-width: 900px) {
  .content-grid--two,
  .settings-grid {
    grid-template-columns: 1fr;
  }

  .market-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 640px) {
  .dashboard-shell {
    padding: 16px 12px 30px;
  }

  .topbar {
    padding: 14px 12px;
  }

  .status-pills {
    justify-content: flex-start;
    width: 100%;
  }

  .stats-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .market-grid {
    grid-template-columns: 1fr;
  }

  .field-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 420px) {
  .stats-grid {
    grid-template-columns: 1fr;
  }

  .primary-btn,
  .secondary-btn {
    width: 100%;
  }
}
